<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBTI 포켓몬 찾기 🔍</title>
    <style>
        /* 기본 스타일 초기화 및 배경/폰트 설정 */
        body {
            margin: 0;
            padding: 0;
            background-color: #FFFBF0; /* 따뜻한 크림색 배경 */
            color: #4A3F35; /* 부드럽고 진한 갈색 텍스트 */
            font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕', sans-serif;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        h1 {
            font-size: 2.2rem;
            margin-top: 50px;
            margin-bottom: 10px;
            color: #D48806; /* 톤 다운된 따뜻한 노란색 */
        }

        p.subtitle {
            font-size: 1.2rem;
            margin-bottom: 40px;
            color: #6C5B4E;
        }

        /* 컨테이너 공통 스타일 */
        .container {
            max-width: 600px;
            width: 90%;
            padding: 30px 20px;
            background-color: #FFFFFF;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
            margin-bottom: 50px;
            box-sizing: border-box;
        }

        /* 16개 MBTI 버튼 그리드 */
        .mbti-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .mbti-btn {
            background-color: #FFDE82; /* 부드러운 노란색 */
            border: none;
            padding: 18px 0;
            border-radius: 12px;
            font-size: 1.3rem;
            font-weight: bold;
            color: #4A3F35;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s;
        }

