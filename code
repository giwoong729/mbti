<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBTI 포켓몬 찾기 🔍</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #FFFBF0;
            color: #4A3F35;
            font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕', sans-serif;
            text-align: center;
        }

        .wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        h1 {
            font-size: 2.2rem;
            margin-top: 40px;
            color: #D48806;
            word-break: keep-all;
        }

        p.subtitle {
            font-size: 1.2rem;
            color: #6C5B4E;
            margin-bottom: 30px;
        }

        .container {
            max-width: 600px;
            width: 100%;
            padding: 30px 20px;
            background-color: #FFFFFF;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
            box-sizing: border-box;
        }

        .mbti-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        @media (max-width: 480px) {
            .mbti-grid { 
                grid-template-columns: repeat(2, 1fr); 
            }
        }

        .mbti-btn {
            background-color: #FFDE82;
            border: none;
            padding: 20px 0;
            border-radius: 12px;
            font-size: 1.3rem;
            font-weight: bold;
            color: #4A3F35;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .mbti-btn:hover {
            background-color: #FFC107;
            transform: translateY(-3px);
        }

        /* 결과 화면 (처음엔 숨김) */
        #result-section {
            display: none;
        }

        .emoji {
            font-size: 6rem;
            margin: 20px 0;
        }

        .pokemon-name {
            font-size: 2.2rem;
            font-weight: bold;
            color: #D48806;
            margin-bottom: 15px;
        }

        .reason {
            font-size: 1.2rem;
            line-height: 1.6;
            background-color: #FFF5D1;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            word-break: keep-all;
        }

        .match {
            font-size: 1.3rem;
            font-weight: bold;
            color: #2F7C7C;
            margin-bottom: 30px;
        }

        .reset-btn {
            background-color: #4A3F35;
            color: #FFFBF0;
            border: none;
            padding: 15px 40px;
            border-radius: 30px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
        }

        .reset-btn:hover {
            background-color: #2D251F;
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <h1>MBTI 포켓몬 찾기 🔍</h1>
        <p class="subtitle">나의 MBTI 유형을 선택해보세요!</p>

        <!-- 1. MBTI 선택 화면 -->
        <div class="container" id="intro-section">
            <div class="mbti-grid" id="mbti-grid">
                <!-- 버튼을 직접 HTML에 작성하여 오류 가능성을 줄였습니다 -->
                <button class="mbti-btn" onclick="showResult('ISTJ')">ISTJ</button>
                <button class="mbti-btn" onclick="showResult('ISFJ')">ISFJ</button>
                <button class="mbti-btn" onclick="showResult('INFJ')">INFJ</button>
                <button class="mbti-btn" onclick="showResult('INTJ')">INTJ</button>
                
                <button class="mbti-btn" onclick="showResult('ISTP')">ISTP</button>
                <button class="mbti-btn" onclick="showResult('ISFP')">ISFP</button>
                <button class="mbti-btn" onclick="showResult('INFP')">INFP</button>
                <button class="mbti-btn" onclick="showResult('INTP')">INTP</button>
                
                <button class="mbti-btn" onclick="showResult('ESTP')">ESTP</button>
                <button class="mbti-btn" onclick="showResult('ESFP')">ESFP</button>
                <button class="mbti-btn" onclick="showResult('ENFP')">ENFP</button>
                <button class="mbti-btn" onclick="showResult('ENTP')">ENTP</button>
                
                <button class="mbti-btn" onclick="showResult('ESTJ')">ESTJ</button>
                <button class="mbti-btn" onclick="showResult('ESFJ')">ESFJ</button>
                <button class="mbti-btn" onclick="showResult('ENFJ')">ENFJ</button>
                <button class="mbti-btn" onclick="showResult('ENTJ')">ENTJ</button>
            </div>
        </div>

        <!-- 2. 결과 확인 화면 -->
        <div class="container" id="result-section">
            <h2 id="user-mbti">MBTI</h2>
            <div class="emoji" id="pokemon-emoji">❓</div>
            <div class="pokemon-name" id="pokemon-name">이름</div>
            <div class="reason" id="pokemon-reason">이유</div>
            <div class="match" id="pokemon-match">짝꿍</div>
            <button class="reset-btn" onclick="resetPage()">🔄 다시 고르기</button>
        </div>
    </div>

    <script>
        const pokemonData = {
            "ISTJ": { name: "꼬부기", emoji: "🐢", reason: "성실하고 묵묵히 제 할 일을 하는 우직한 성격입니다.<br>규칙을 잘 지키며 책임감이 아주 강합니다.", match: "ESTP" },
            "ISFJ": { name: "해피너스", emoji: "🥚", reason: "다른 사람을 돌보는 것을 좋아하고 따뜻한 마음을 가졌습니다.<br>언제나 주변 사람들의 든든한 지원군이 되어줍니다.", match: "ESFP" },
            "INFJ": { name: "나인테일", emoji: "🦊", reason: "신비롭고 직관력이 뛰어나며 생각이 깊습니다.<br>뛰어난 통찰력으로 사람들의 진심을 꿰뚫어 봅니다.", match: "ENFP" },
            "INTJ": { name: "야부엉", emoji: "🦉", reason: "조용하지만 지능적이고 전략적인 사고를 즐깁니다.<br>항상 철저하게 미래를 계획하고 상황을 분석합니다.", match: "ENTP" },
            "ISTP": { name: "나무지기", emoji: "🦎", reason: "시크하고 독립적이며 개인 시간을 중요하게 생각합니다.<br>위기 상황에서도 침착하게 문제를 해결하는 능력이 뛰어납니다.", match: "ESTJ" },
            "ISFP": { name: "뚜벅쵸", emoji: "🌸", reason: "자연을 사랑하고 갈등을 싫어하는 평화주의자입니다.<br>조용해 보이지만 내면에는 따뜻한 감수성을 품고 있습니다.", match: "ESFJ" },
            "INFP": { name: "버터플", emoji: "🦋", reason: "꿈이 많고 낭만적이며 상상력이 풍부합니다.<br>세상을 아름답게 바라보는 순수하고 따뜻한 마음을 가졌습니다.", match: "ENFJ" },
            "INTP": { name: "잠만보", emoji: "💤", reason: "혼자만의 시간을 가장 사랑하며 눕는 것을 좋아합니다.<br>느긋해 보이지만 머릿속은 항상 기발한 생각으로 가득 찼습니다.", match: "ENTJ" },
            "ESTP": { name: "피카츄", emoji: "⚡", reason: "에너지가 넘치고 스릴을 즐기는 행동파입니다.<br>어디서나 주목받는 분위기 메이커이며 적응력이 뛰어납니다.", match: "ISTJ" },
            "ESFP": { name: "에이팜", emoji: "🐒", reason: "장난기가 많고 긍정적인 에너지를 뿜어냅니다.<br>사람들과 함께 어울려 놀 때 가장 큰 행복을 느낍니다.", match: "ISFJ" },
            "ENFP": { name: "포니타", emoji: "🦄", reason: "자유로운 영혼의 소유자로 호기심이 아주 많습니다.<br>열정적이고 새로운 도전을 절대 두려워하지 않습니다.", match: "INFJ" },
            "ENTP": { name: "리자몽", emoji: "🐉", reason: "자신감이 넘치고 두뇌 회전이 매우 빠릅니다.<br>논리적인 대화를 즐기며 항상 기발한 아이디어를 뿜어냅니다.", match: "INTJ" },
            "ESTJ": { name: "피죤투", emoji: "🦅", reason: "책임감이 강하고 무리를 이끄는 훌륭한 리더십을 발휘합니다.<br>정해진 목표를 향해 흔들림 없이 직진하는 스타일입니다.", match: "ISTP" },
            "ESFJ": { name: "가디", emoji: "🐶", reason: "충성심이 강하고 주변 사람들을 누구보다 살뜰히 챙깁니다.<br>다 같이 행복한 공동체의 조화를 가장 중요하게 생각합니다.", match: "ISFP" },
            "ENFJ": { name: "해루미", emoji: "☀️", reason: "밝고 긍정적인 에너지로 사람들을 이끄는 카리스마가 있습니다.<br>타인의 성장을 돕고 응원하는 데에서 큰 기쁨을 느낍니다.", match: "INFP" },
            "ENTJ": { name: "화염레오", emoji: "🦁", reason: "타고난 지도자이며 목표 달성을 위해 거침없이 나아갑니다.<br>어떤 상황에서도 밀어붙이는 카리스마와 결단력을 갖췄습니다.", match: "INTP" }
        };

        function showResult(mbti) {
            // 화면 전환
            document.getElementById('intro-section').style.display = 'none';
            document.getElementById('result-section').style.display = 'block';

            // 데이터 채우기
            const data = pokemonData[mbti];
            document.getElementById('user-mbti').innerText = `당신의 MBTI [ ${mbti} ] 와 어울리는 포켓몬은?`;
            document.getElementById('pokemon-emoji').innerText = data.emoji;
            document.getElementById('pokemon-name').innerText = data.name;
            document.getElementById('pokemon-reason').innerHTML = data.reason;
            document.getElementById('pokemon-match').innerText = "💖 환상의 짝꿍: " + data.match;
        }

        function resetPage() {
            // 다시 초기화
            document.getElementById('result-section').style.display = 'none';
            document.getElementById('intro-section').style.display = 'block';
        }
    </script>
</body>
</html>
